# Passclip settings. Copy this file to .env.local and fill it in.
# Never commit .env.local or any certificate or key file.

# Apple Wallet pass signing (server only). See docs/SPEC.md §6.
PASS_TYPE_IDENTIFIER=pass.com.example.passclip
APPLE_TEAM_ID=
# Each value is the PEM file encoded as base64 on a single line.
PASS_SIGNER_CERT_PEM_BASE64=
PASS_SIGNER_KEY_PEM_BASE64=
PASS_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM_BASE64=

# Public address of the site, used in links on the back of passes.
PUBLIC_BASE_URL=http://localhost:3000

# Rate limit (30 pass, calendar and import requests a minute per visitor). On Vercel it uses
# x-vercel-forwarded-for automatically. Elsewhere, name a header your host sets and visitors
# can't fake (for example CF-Connecting-IP behind Cloudflare). Leave empty to share one budget.
RATE_LIMIT_IP_HEADER=

# Optional: file uploads (attachments on the back of passes, docs/SPEC.md §9).
# Any S3-compatible bucket works, such as Supabase Storage or Cloudflare R2. Uploads stay off
# until all six are set. Set them up with docs/LAUNCH.md, then run npm run check:storage.
# The bucket's S3 address, like https://<project>.storage.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=
# Its region, like ap-northeast-1 (Supabase shows it next to the S3 address), or auto for R2.
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Where the bucket's files can be read, like https://<project>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=
